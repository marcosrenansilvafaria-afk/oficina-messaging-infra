{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://oficina.dev/schemas/saga/orcamento-gerado.schema.json",
  "title": "OrcamentoGeradoEvent",
  "allOf": [{ "$ref": "envelope.schema.json" }],
  "properties": {
    "eventType": { "const": "OrcamentoGeradoEvent" },
    "payload": {
      "type": "object",
      "required": ["ordemServicoId", "valorTotal", "itens", "geradoEm"],
      "properties": {
        "ordemServicoId": { "type": "string" },
        "valorTotal": { "type": "number", "minimum": 0 },
        "itens": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["descricao", "tipo", "preco", "quantidade"],
            "properties": {
              "descricao": { "type": "string" },
              "tipo": { "enum": ["SERVICO", "PECA"] },
              "preco": { "type": "number", "minimum": 0 },
              "quantidade": { "type": "integer", "minimum": 1 }
            },
            "additionalProperties": false
          }
        },
        "geradoEm": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    }
  }
}
