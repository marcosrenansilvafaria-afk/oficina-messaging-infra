{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://oficina.dev/schemas/saga/pagamento-recusado.schema.json",
  "title": "PagamentoRecusadoEvent",
  "allOf": [{ "$ref": "envelope.schema.json" }],
  "properties": {
    "eventType": { "const": "PagamentoRecusadoEvent" },
    "payload": {
      "type": "object",
      "required": ["ordemServicoId", "pagamentoId", "mercadoPagoPaymentId", "motivo", "recusadoEm"],
      "properties": {
        "ordemServicoId": { "type": "string" },
        "pagamentoId": { "type": "string" },
        "mercadoPagoPaymentId": { "type": "string" },
        "motivo": { "type": "string" },
        "recusadoEm": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    }
  }
}
