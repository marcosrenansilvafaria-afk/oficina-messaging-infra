{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://oficina.dev/schemas/saga/os-criada.schema.json",
  "title": "OSCriadaEvent",
  "allOf": [{ "$ref": "envelope.schema.json" }],
  "properties": {
    "eventType": { "const": "OSCriadaEvent" },
